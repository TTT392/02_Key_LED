  96:Core/Src/main.c ****   /* USER CODE END 2 */
  97:Core/Src/main.c **** 
  98:Core/Src/main.c ****   /* Infinite loop */
  99:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 100:Core/Src/main.c ****   while (1)
 101:Core/Src/main.c ****   {
 102:Core/Src/main.c ****     /* USER CODE END WHILE */
 103:Core/Src/main.c **** 
 104:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 105:Core/Src/main.c ****     if (key_pressed == 1) // 如果中断记录到按键被按下
 106:Core/Src/main.c **** {
 107:Core/Src/main.c ****     HAL_Delay(20); // 延迟20ms，躲避按键抖动
 108:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) // 再次确认确实按下了
 109:Core/Src/main.c ****     {
 110:Core/Src/main.c ****         led_state = (led_state + 1) % 3; // 切换档位 0->1, 1->2, 2->0
 111:Core/Src/main.c ****         if (led_state == 0) led_delay_ms = 500;       // 1秒周期
 112:Core/Src/main.c ****         else if (led_state == 1) led_delay_ms = 1000; // 2秒周期
 113:Core/Src/main.c ****         else if (led_state == 2) led_delay_ms = 250;  // 0.5秒周期
 114:Core/Src/main.c ****     }
 115:Core/Src/main.c ****     while (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET); // 死等松手（防长按连�
 116:Core/Src/main.c ****     key_pressed = 0; // 清除标志，准备下一次
 117:Core/Src/main.c **** }
 118:Core/Src/main.c ****   }
 119:Core/Src/main.c ****   /* USER CODE END 3 */
 120:Core/Src/main.c **** }
